﻿<MudDialog>
    <DialogContent>
        <div style="display: flex; justify-content: center; align-items: center;">
            <MudImage Src="images/question.png" Width="100" Height="100" Class="mb-3" />
        </div>
        <MudText>@Message</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Check"
                   Color="Color.Success"
                   OnClick="Accept"
                   FullWidth="true">
            Si
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Cancel"
                   Color="Color.Secondary"
                   OnClick="Cancel"
                   FullWidth="true">
            No
        </MudButton>
    </DialogActions>
</MudDialog>